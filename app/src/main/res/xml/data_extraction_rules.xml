<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The broker password and the enrollment token (AgentSettings.SECRETS_FILE)
   are never backed up or transferred. Everything else follows the defaults.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="phoenix_agent_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="phoenix_agent_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
